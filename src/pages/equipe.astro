---
/**
 * Nossa equipe — fotos reais da equipe Loft English, com destaque para a Teacher Fabiola (dona da escola).
 * Imagens: kit "LOFT-ENGLISH-ASSETS-CLAUDE-CODE" (21/11/2026), WebPs otimizados, cópias em src/assets/images/equipe/.
 * Regras do kit: não inventar nomes, cargos ou biografias — só "Teacher Fabiola" é nomeada
 * (forma como é chamada na escola, informada pelo responsável). Os professores não têm nome exibido.
 * Textos curtos e editoriais; a proprietária deve validá-los antes da versão oficial.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Mascote from '../components/Mascote.astro';
import type { IconName } from '../components/icons';
import { primaryContact, site } from '../config/site';
import fotoFabiola from '../assets/images/equipe/loft-equipe-fabiola.webp';
import fotoEquipeVermelho from '../assets/images/equipe/loft-equipe-grupo-vermelho.webp';
import fotoEquipeEmPe from '../assets/images/equipe/loft-equipe-grupo-em-pe.webp';
import fotoProfessor1 from '../assets/images/equipe/loft-equipe-professor-01.webp';
import fotoProfessor2 from '../assets/images/equipe/loft-equipe-professor-02.webp';

const cta = primaryContact();

const jeitos: { icon: IconName; titulo: string; texto: string }[] = [
  { icon: 'users', titulo: 'Preparo para cada fase', texto: 'Aulas pensadas para o ritmo de Kids, Teens e Adults.' },
  { icon: 'messages-square', titulo: 'Inglês na prática', texto: 'Conversa, música e jogos para usar o idioma de verdade.' },
  { icon: 'shield-check', titulo: 'Acolhimento em sala', texto: 'Um ambiente em que todo aluno se sente à vontade para participar.' },
];
---

<BaseLayout
  title="Nossa equipe | Loft English – São Gabriel da Palha (ES)"
  description="Conheça a equipe da Loft English, escola de inglês em São Gabriel da Palha (ES), e a Teacher Fabiola, que está à frente da escola."
>
  <PageHero
    eyebrow="Nossa equipe"
    title="Gente de verdade, todos os dias na Loft."
    lead={`Conheça quem recebe os alunos, prepara as aulas e faz o inglês acontecer em ${site.city}.`}
  />

  <!-- Destaque: Teacher Fabiola -->
  <section class="section fabiola" aria-labelledby="fabiola-title">
    <div class="container fabiola__grid">
      <div class="fabiola__retrato" data-reveal="foto">
        <span class="fabiola__arco-fundo" aria-hidden="true"></span>
        <div class="fabiola__foto media-fill">
          <Picture
            src={fotoFabiola}
            alt="Retrato da Teacher Fabiola, de blazer vermelho, sorrindo"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={80}
            widths={[400, 600, 900]}
            sizes="(min-width: 64rem) 26rem, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="fabiola__faixa" aria-hidden="true">Teacher Fabiola</p>
        <Mascote variante="circulo" largura={150} class="fabiola__mascote" reveal="zoom" revealDelay={600} />
      </div>

      <div class="fabiola__texto">
        <p class="eyebrow" data-reveal>À frente da Loft English</p>
        <h2 id="fabiola-title" class="fabiola__nome" data-reveal style="--reveal-delay:100ms">Teacher Fabiola</h2>
        <p class="fabiola__bio" data-reveal style="--reveal-delay:200ms">
          É assim que alunos e equipe chamam a dona da Loft English. Ela acompanha de perto o dia a dia das turmas e da
          equipe, com um propósito que está na assinatura da escola: usar o inglês para abrir caminhos.
        </p>
        <p class="fabiola__slogan" lang="en" data-reveal style="--reveal-delay:300ms">{site.slogan}</p>

        <figure class="fabiola__com-equipe" data-reveal style="--reveal-delay:350ms">
          <div class="fabiola__com-equipe-foto media-fill">
            <Picture
              src={fotoEquipeVermelho}
              alt="Teacher Fabiola com três integrantes da equipe, todas de blusa vermelha, diante da parede da Loft English"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={78}
              widths={[480, 720, 1000]}
              sizes="(min-width: 64rem) 34rem, 92vw"
              loading="lazy"
            />
          </div>
          <figcaption>Com a equipe, na parede da Loft.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- A equipe -->
  <section class="section section--alt time" aria-labelledby="time-title">
    <div class="container time__grid">
      <div class="time__texto">
        <p class="eyebrow" data-reveal>A equipe</p>
        <h2 id="time-title" data-reveal style="--reveal-delay:100ms">Preparada para cada fase do aprendizado.</h2>
        <p class="lead" data-reveal style="--reveal-delay:200ms">
          Do primeiro contato com o idioma às conversas mais avançadas, a equipe da Loft trabalha junto para que o inglês
          faça parte da rotina de cada aluno.
        </p>
        <ul class="jeitos">
          {
            jeitos.map((j, i) => (
              <li class="jeito" data-reveal style={`--reveal-delay:${250 + i * 120}ms`}>
                <span class="jeito__icon">
                  <Icon name={j.icon} size={20} />
                </span>
                <div>
                  <h3 class="jeito__titulo">{j.titulo}</h3>
                  <p class="jeito__texto">{j.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="time__foto media-fill" data-reveal="foto" style="--reveal-delay:150ms">
        <Picture
          src={fotoEquipeEmPe}
          alt="Cinco integrantes da equipe Loft English, entre elas a Teacher Fabiola ao centro, caminhando lado a lado"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={78}
          widths={[600, 900, 1400]}
          sizes="(min-width: 64rem) 40rem, 92vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Professores + convite -->
  <section class="section professores" aria-labelledby="professores-title">
    <div class="container">
      <h2 id="professores-title" class="professores__titulo" data-reveal>Também fazem parte do time.</h2>
      <div class="professores__grid">
        <div class="professor media-fill" data-reveal="arco">
          <Picture
            src={fotoProfessor1}
            alt="Professor da equipe Loft English, de camisa polo clara, sorrindo"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={78}
            widths={[360, 540, 900]}
            sizes="(min-width: 64rem) 22rem, 45vw"
            loading="lazy"
          />
        </div>
        <div class="professor media-fill" data-reveal="arco" style="--reveal-delay:150ms">
          <Picture
            src={fotoProfessor2}
            alt="Professor da equipe Loft English, de camiseta branca e vermelha, sorrindo diante da bandeira dos Estados Unidos"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={78}
            widths={[360, 540, 900]}
            sizes="(min-width: 64rem) 22rem, 45vw"
            loading="lazy"
          />
        </div>

        <div class="convite on-dark" data-reveal="zoom" style="--reveal-delay:300ms">
          <p class="convite__texto">Quer conhecer a equipe de perto?</p>
          <a class="convite__link" href={cta.href} target="_blank" rel="noopener noreferrer">
            <Icon name={cta.channel === 'whatsapp' ? 'whatsapp' : 'instagram'} size={20} />
            <span>{cta.label}</span>
            <span class="visually-hidden"> (abre em nova aba)</span>
          </a>
          <Mascote variante="corpo" largura={220} class="convite__mascote" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Teacher Fabiola ---------- */
  .fabiola {
    overflow-x: clip;
  }

  .fabiola__grid {
    display: grid;
    gap: clamp(var(--sp-8), 2rem + 4vw, var(--sp-11));
    align-items: center;
  }

  .fabiola__retrato {
    position: relative;
    justify-self: center;
    width: min(82%, 26rem);
    padding-bottom: var(--sp-6);
  }

  /* Arco vermelho deslocado atrás do retrato */
  .fabiola__arco-fundo {
    position: absolute;
    inset: 6% -7% 10% 7%;
    border-radius: 999px 999px var(--r-xl) var(--r-xl);
    background: var(--brand-red);
  }

  .fabiola__foto {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px var(--r-xl) var(--r-xl);
    overflow: hidden;
    background: var(--brand-navy);
    box-shadow: var(--shadow-2);
  }

  .fabiola__foto :global(img) {
    object-position: 50% 30%;
  }

  .fabiola__faixa {
    position: absolute;
    left: -6%;
    bottom: 2%;
    z-index: 1;
    padding: 0.625rem 1.75rem;
    background: var(--brand-red);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 0.8rem + 0.8vw, 1.375rem);
    white-space: nowrap;
    rotate: -5deg;
    clip-path: polygon(0 0, 100% 0, 95% 50%, 100% 100%, 0 100%, 5% 50%);
    box-shadow: var(--shadow-1);
  }

  .fabiola__retrato :global(.fabiola__mascote) {
    position: absolute;
    right: -10%;
    top: -4%;
    width: min(32%, 8.5rem);
    z-index: 1;
  }

  .fabiola__texto {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }

  .fabiola__nome {
    font-size: var(--fs-3xl);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--brand-red-deep);
  }

  .fabiola__bio {
    max-width: 46ch;
    font-size: var(--fs-md);
    color: var(--color-muted);
    line-height: 1.7;
  }

  .fabiola__slogan {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    color: var(--brand-red);
  }

  .fabiola__com-equipe {
    width: 100%;
    margin: var(--sp-4) 0 0;
  }

  .fabiola__com-equipe-foto {
    aspect-ratio: 3 / 2;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .fabiola__com-equipe-foto :global(img) {
    object-position: 50% 35%;
  }

  .fabiola__com-equipe figcaption {
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .fabiola__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .fabiola__retrato {
      width: 100%;
      max-width: 27rem;
    }
  }

  /* ---------- A equipe ---------- */
  .time__grid {
    display: grid;
    gap: var(--sp-8);
    align-items: center;
  }

  .time__texto {
    display: grid;
    gap: var(--sp-4);
  }

  .time__texto h2 {
    font-size: var(--fs-2xl);
    font-weight: 800;
    max-width: 18ch;
  }

  .jeitos {
    list-style: none;
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }

  .jeito {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }

  .jeito__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--brand-red);
    color: #fff;
  }

  .jeito__titulo {
    font-size: var(--fs-md);
    font-weight: 700;
  }

  .jeito__texto {
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .time__foto {
    aspect-ratio: 4 / 3;
    border-radius: 999px var(--r-xl) var(--r-xl) 999px;
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .time__foto :global(img) {
    object-position: 50% 30%;
  }

  @media (min-width: 64rem) {
    .time__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--sp-10);
    }
  }

  /* ---------- Professores + convite ---------- */
  .professores {
    overflow-x: clip;
  }

  .professores__titulo {
    font-size: var(--fs-2xl);
    font-weight: 800;
    text-align: center;
    margin-bottom: clamp(var(--sp-7), 2rem + 2vw, var(--sp-9));
  }

  .professores__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  .professor {
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px var(--r-lg) var(--r-lg);
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .professor :global(img) {
    object-position: 50% 30%;
  }

  .convite {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--sp-5);
    min-height: 14rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--brand-red-deep);
    color: #fff;
  }

  .convite__texto {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 800;
    line-height: 1.15;
    max-width: 14ch;
  }

  .convite__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--brand-red-deep);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .convite__link:hover {
    transform: translateY(-2px);
  }

  .convite :global(.convite__mascote) {
    position: absolute;
    right: -4%;
    bottom: -6%;
    width: min(46%, 12rem);
    z-index: -1;
  }

  @media (min-width: 48rem) {
    .professores__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-5);
    }

    .convite {
      grid-column: auto;
      min-height: 0;
      border-radius: var(--r-xl) var(--r-xl) var(--r-xl) 999px;
      align-content: start;
      padding-top: clamp(2rem, 1rem + 3vw, 3.5rem);
    }

    .convite :global(.convite__mascote) {
      right: 6%;
      bottom: 4%;
      width: min(62%, 13rem);
      z-index: 0;
    }
  }
</style>
