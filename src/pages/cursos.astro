---
import { url } from '../lib/url';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ContactBand from '../components/ContactBand.astro';
import { courses, askTheTeam } from '../data/courses';
import { primaryContact } from '../config/site';

const detailLabels = {
  ages: 'Idades',
  format: 'Modalidade',
  schedule: 'Aulas',
} as const;
---

<BaseLayout
  title="Cursos de inglês para crianças, adolescentes e adultos | Loft English"
  description="Conheça os cursos Kids, Teens e Adults da Loft English em São Gabriel da Palha (ES) e consulte com a equipe as turmas, modalidades e condições disponíveis."
>
  <PageHero
    eyebrow="Cursos"
    title="Inglês para crianças, adolescentes e adultos."
    lead="A Loft English organiza seus cursos em três públicos. Escolha o seu e fale com a equipe para conhecer turmas, modalidades e condições."
  >
    <nav class="course-nav" aria-label="Públicos">
      <ul>
        {
          courses.map((c) => (
            <li>
              <a href={`#${c.id}`}>
                <Icon name={c.icon} size={18} />
                <span lang="en">{c.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHero>

  <div class="courses">
    {
      courses.map((course, i) => {
        const cta = primaryContact(course.name);
        const filled = (Object.keys(detailLabels) as (keyof typeof detailLabels)[]).filter((k) => course.details[k]);
        return (
          <section class:list={['course', i % 2 === 1 && 'course--alt']} id={course.id} aria-labelledby={`${course.id}-title`}>
            <div class="container course__grid">
              <div
                class="course__visual media-fill"
                style={course.image ? `--pos-m: ${course.image.position?.mobile ?? '50% 50%'}; --pos-d: ${course.image.position?.desktop ?? '50% 50%'}` : undefined}
              >
                {course.image ? (
                  <Picture
                    src={course.image.src}
                    alt={course.image.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    quality={70}
                    widths={[480, 720, 1080]}
                    sizes="(min-width: 64rem) 40vw, 92vw"
                    loading="lazy"
                    class="course__photo"
                  />
                ) : (
                  <div class="course__type" aria-hidden="true">
                    <span class="course__type-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="course__type-name">{course.name}</span>
                    <span class="course__type-icon">
                      <Icon name={course.icon} size={32} strokeWidth={1.5} />
                    </span>
                  </div>
                )}
              </div>

              <div class="course__content">
                <p class="eyebrow">{course.audience}</p>
                <h2 id={`${course.id}-title`}>
                  <span lang="en">{course.name}</span>
                  <span class="course__headline">{course.headline}</span>
                </h2>
                <p class="course__desc">{course.description}</p>

                {filled.length > 0 && (
                  <dl class="course__details">
                    {filled.map((k) => (
                      <div>
                        <dt>{detailLabels[k]}</dt>
                        <dd>{course.details[k]}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="course__ask">
                  <h3>O que você pode consultar com a equipe</h3>
                  <ul>
                    {askTheTeam.map((item) => (
                      <li>
                        <Icon name="help-circle" size={18} />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <Button href={cta.href} external icon={cta.channel === 'whatsapp' ? 'whatsapp' : 'instagram'} iconPosition="start" ariaLabel={`Perguntar sobre ${course.name}: ${cta.label}`}>
                  Perguntar sobre {course.name}
                </Button>
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <ContactBand
    title="Ainda em dúvida sobre qual curso escolher?"
    text="Conte para a equipe da Loft English quem vai estudar e o que você procura."
    secondary={{ href: url('/contato/'), label: 'Ver formas de contato' }}
  />
</BaseLayout>

<style>
  .course-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  .course-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0.5rem 1.125rem;
    border-radius: var(--r-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .course-nav a :global(svg) {
    color: var(--brand-red);
  }

  .course-nav a:hover {
    border-color: var(--brand-red);
    color: var(--brand-red);
  }

  .course {
    padding-block: var(--section-y);
  }

  .course + .course {
    border-top: 1px solid var(--color-line);
  }

  .course__grid {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  .course__visual {
    border-radius: var(--r-xl);
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: var(--color-surface-alt);
  }

  .course__visual :global(.course__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-m, 50% 50%);
  }

  .course__type {
    position: relative;
    height: 100%;
    display: grid;
    align-content: end;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    background:
      linear-gradient(var(--color-line) 1px, transparent 1px) 0 0 / 100% 25%,
      var(--color-surface-alt);
  }

  .course__type-num {
    position: absolute;
    top: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    left: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .course__type-icon {
    position: absolute;
    top: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    right: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--r-md);
    background: var(--color-surface);
    color: var(--brand-red);
  }

  .course__type-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 2rem + 9vw, 8.5rem);
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--brand-navy);
  }

  .course__content {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .course__content h2 {
    display: grid;
    gap: var(--sp-2);
    font-size: var(--fs-2xl);
    font-weight: 800;
  }

  .course__headline {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink-soft);
  }

  .course__desc {
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 36rem;
  }

  .course__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--sp-3);
    width: 100%;
    margin: 0;
  }

  .course__details div {
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--color-surface-alt);
  }

  .course__details dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-red);
  }

  .course__details dd {
    margin: var(--sp-1) 0 0;
    font-weight: 600;
    color: var(--color-ink);
  }

  .course__ask {
    width: 100%;
    max-width: 36rem;
    padding: var(--sp-5);
    border: 1px solid var(--color-line);
    border-radius: var(--r-lg);
  }

  .course__ask h3 {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: var(--sp-4);
  }

  .course__ask ul {
    list-style: none;
    display: grid;
    gap: var(--sp-3);
  }

  .course__ask li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--color-text);
  }

  .course__ask li :global(svg) {
    flex: none;
    color: var(--brand-red);
  }

  @media (min-width: 40rem) {
    .course__ask ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .course__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: clamp(3rem, 1rem + 5vw, 7rem);
    }

    .course--alt .course__visual {
      order: 2;
    }

    .course__visual {
      aspect-ratio: 4 / 5;
    }

    .course__visual :global(.course__photo) {
      object-position: var(--pos-d, 50% 50%);
    }
  }
</style>
