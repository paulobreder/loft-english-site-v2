---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Página não encontrada | Loft English" description="A página procurada não existe ou foi movida." noindex>
  <PageHero eyebrow="Erro 404" title="Página não encontrada." lead="O endereço pode ter mudado ou não existir mais. Continue pela página inicial ou conheça os cursos.">
    <div class="actions">
      <Button href={url('/')} icon="arrow-right">Ir para o início</Button>
      <Button href={url('/cursos/')} variant="secondary">Conheça os cursos</Button>
    </div>
  </PageHero>
  <div class="spacer"></div>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .spacer {
    height: var(--section-y);
  }
</style>
