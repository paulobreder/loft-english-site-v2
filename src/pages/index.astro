---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import VidaNaLoft from '../components/home/VidaNaLoft.astro';
import SobreNos from '../components/home/SobreNos.astro';
import PorQueIngles from '../components/home/PorQueIngles.astro';
import FormasDeEstudar from '../components/home/FormasDeEstudar.astro';
import ProvaSocial from '../components/home/ProvaSocial.astro';
import AudienceCard from '../components/AudienceCard.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/home/CtaFinal.astro';
import FatosLoft from '../components/home/FatosLoft.astro';
import ValoresCarrossel from '../components/home/ValoresCarrossel.astro';
import Depoimentos from '../components/home/Depoimentos.astro';
import { courses } from '../data/courses';
import { faq } from '../data/faq';
import { site } from '../config/site';
---

<BaseLayout
  title="Loft English: escola de inglês em São Gabriel da Palha – ES"
  description="Conheça a Loft English em São Gabriel da Palha (ES). Inglês para crianças, adolescentes e adultos: Kids, Teens e Adults. Fale com a equipe para saber mais."
>
  <Hero />

  <!-- Públicos -->
  <section class="section audiences" aria-labelledby="aud-title">
    <div class="container">
      <div class="audiences__head">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Cursos</p>
          <h2 id="aud-title">Cada fase tem seu jeito de aprender.</h2>
        </div>
        <p class="lead" data-reveal style="--reveal-delay:150ms">Conheça as opções da Loft English para diferentes momentos da vida e encontre o seu caminho no inglês.</p>
      </div>
      <div class="audiences__grid">
        {
          courses.map((course, i) => (
            <div class="audiences__item" data-reveal style={`--reveal-delay:${i * 130}ms`}>
              <AudienceCard course={course} index={i} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SobreNos />

  <FatosLoft />

  <!-- Manifesto -->
  <section class="statement" aria-labelledby="statement-title">
    <div class="container statement__inner">
      <p class="statement__label" data-reveal>Como a Loft English se apresenta</p>
      <h2 id="statement-title" class="statement__quote" data-reveal style="--reveal-delay:120ms">
        Inglês de verdade, <span>para a vida.</span>
      </h2>
      <p class="statement__sub" data-reveal style="--reveal-delay:280ms">Fale inglês com confiança.</p>
      <p class="statement__slogan" lang="en" data-reveal style="--reveal-delay:420ms">{site.slogan}</p>
    </div>
  </section>

  <ValoresCarrossel />

  <PorQueIngles />

  <VidaNaLoft />

  <Depoimentos />

  <FormasDeEstudar />

  <ProvaSocial />

  <!-- Dúvidas -->
  <section class="section faq-section" aria-labelledby="faq-title">
    <div class="container faq-section__grid">
      <div class="section-head faq-section__head" data-reveal>
        <p class="eyebrow">Dúvidas</p>
        <h2 id="faq-title">Antes de começar.</h2>
        <p class="lead">Respostas diretas para as perguntas mais comuns. Para detalhes de turmas e valores, fale com a equipe.</p>
      </div>
      <div data-reveal style="--reveal-delay:150ms">
        <Faq items={faq} />
      </div>
    </div>
  </section>

  <CtaFinal />
</BaseLayout>

<style>
  /* ---------- Públicos ---------- */
  .audiences__head {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: clamp(var(--sp-7), 2rem + 2vw, var(--sp-9));
  }

  .audiences__head .section-head {
    margin-bottom: 0;
  }

  .audiences__grid {
    display: grid;
    gap: var(--sp-4);
  }

  .audiences__item {
    display: grid;
  }

  @media (min-width: 48rem) {
    .audiences__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .audiences__head {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      gap: var(--sp-9);
    }

    .audiences__grid {
      gap: var(--sp-5);
    }
  }

  /* ---------- Manifesto ---------- */
  .statement {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(5rem, 3rem + 8vw, 10rem);
    background:
      repeating-linear-gradient(180deg, rgb(255 255 255 / 0.07) 0 26px, transparent 26px 52px),
      var(--brand-red);
    color: #fff;
    text-align: center;
  }

  /* Cantão azul com estrelas: referência ao inglês americano */
  .statement::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    width: min(22%, 15rem);
    height: 46%;
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.9) 0 1.6px, transparent 2.2px) 0 0 / 26px 26px,
      radial-gradient(circle, rgb(255 255 255 / 0.9) 0 1.6px, transparent 2.2px) 13px 13px / 26px 26px,
      var(--brand-navy);
    border-bottom-right-radius: var(--r-xl);
  }

  .statement__inner {
    display: grid;
    justify-items: center;
    gap: var(--sp-5);
  }

  .statement__label {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  .statement__quote {
    font-size: clamp(2.25rem, 1.2rem + 5vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 16ch;
    color: #fff;
    text-wrap: balance;
  }

  .statement__quote span {
    color: #fff;
  }

  .statement__sub {
    position: relative;
    padding-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: #fff;
  }

  .statement__sub::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 3rem;
    height: 3px;
    border-radius: 3px;
    background: #fff;
    translate: -50% 0;
  }

  /* Assinatura da marca (saiu do bloco de pontos fortes) */
  .statement__slogan {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-style: italic;
    font-weight: 600;
  }

  .statement__slogan::before,
  .statement__slogan::after {
    content: '';
    width: clamp(1.5rem, 4vw, 3rem);
    height: 1px;
    background: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 40rem) {
    .statement__slogan {
      font-size: var(--fs-md);
    }

    .statement__slogan::before,
    .statement__slogan::after {
      display: none;
    }

    .statement::before {
      width: 30%;
      height: 18%;
    }
  }

  /* ---------- FAQ ---------- */
  .faq-section__grid {
    display: grid;
    gap: var(--sp-6);
  }

  .faq-section__head {
    margin-bottom: 0;
    align-content: start;
  }

  @media (min-width: 64rem) {
    .faq-section__grid {
      grid-template-columns: 1fr 1.5fr;
      gap: var(--sp-10);
    }

    .faq-section__head {
      position: sticky;
      top: calc(var(--header-h) + var(--sp-6));
    }
  }
</style>
