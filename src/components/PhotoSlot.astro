---
/**
 * Espaço reservado para fotografia REAL e AUTORIZADA da escola.
 * - Com `image`: exibe a foto otimizada (AVIF/WebP, srcset).
 * - Sem `image`: exibe composição de marca neutra (búfalo + slogan), sem simular foto.
 * Ver docs/STATUS.md › "Como ativar fotos".
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BuffaloMark from './BuffaloMark.astro';
import { site } from '../config/site';

interface Props {
  image?: { src: ImageMetadata; alt: string } | null;
  ratio?: string;
  class?: string;
  sizes?: string;
}

const { image = null, ratio = '4 / 5', class: className, sizes = '(min-width: 64rem) 45vw, 92vw' } = Astro.props;
---

<figure class:list={['photo-slot', 'media-fill', !image && 'photo-slot--brand', className]} style={`--ratio: ${ratio}`}>
  {
    image ? (
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={70}
        widths={[480, 720, 1080]}
        sizes={sizes}
        loading="lazy"
      />
    ) : (
      <div class="photo-slot__brand" aria-hidden="true">
        <BuffaloMark class="photo-slot__mark" />
        <span class="photo-slot__slogan" lang="en">{site.slogan}</span>
      </div>
    )
  }
</figure>

<style>
  .photo-slot {
    position: relative;
    margin: 0;
    aspect-ratio: var(--ratio);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .photo-slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-slot__brand {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--sp-5);
    padding: var(--sp-6) var(--sp-6) 26%;
    background: var(--color-surface);
    overflow: hidden;
  }

  /* Faixas diagonais navy + vermelho, como na capa da apostila da marca */
  .photo-slot__brand::before,
  .photo-slot__brand::after {
    content: '';
    position: absolute;
    left: -5%;
    right: -5%;
    bottom: 0;
  }

  .photo-slot__brand::before {
    height: 30%;
    background: var(--brand-red);
    clip-path: polygon(0 62%, 100% 0, 100% 100%, 0 100%);
  }

  .photo-slot__brand::after {
    height: 25%;
    background: var(--brand-navy);
    clip-path: polygon(0 70%, 100% 6%, 100% 100%, 0 100%);
  }

  .photo-slot :global(.photo-slot__mark) {
    position: relative;
    width: min(46%, 14rem);
    height: auto;
  }

  .photo-slot__slogan {
    position: relative;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: var(--fs-lg);
    color: var(--brand-red);
    text-align: center;
  }
</style>
