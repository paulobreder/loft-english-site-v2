---
import { url } from '../lib/url';
/**
 * Card tipográfico de público (Kids / Teens / Adults).
 * Sem foto por decisão aprovada. Slot de imagem já preparado: se `course.image`
 * for preenchido em src/data/courses.ts, a foto aparece no topo do card
 * sem alterar a arquitetura.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { Course } from '../data/courses';

interface Props {
  course: Course;
  index: number;
  headingLevel?: 'h3' | 'h2';
}

const { course, index, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const num = String(index + 1).padStart(2, '0');
---

<article class:list={['aud-card', course.image && 'aud-card--photo', `aud-card--tom-${index % 3}`]}>
  {
    course.image && (
      <div class="aud-card__media media-fill" style={`--obj-pos: ${course.image.position?.card ?? '50% 50%'}`}>
        <Picture
          src={course.image.src}
          alt={course.image.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={70}
          widths={[360, 560, 800]}
          sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 92vw"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="aud-card__body">
    <div class="aud-card__top">
      <span class="aud-card__icon"><Icon name={course.icon} size={24} /></span>
      <span class="aud-card__num" aria-hidden="true">{num}</span>
    </div>
    <p class="aud-card__audience">{course.audience}</p>
    <Heading class="aud-card__name" lang="en">{course.name}</Heading>
    <p class="aud-card__summary">{course.summary}</p>
    <a class="aud-card__link" href={url(`/cursos/#${course.id}`)}>
      <span>Ver {course.name}</span>
      <Icon name="arrow-right" size={18} />
      <span class="aud-card__stretch" aria-hidden="true"></span>
    </a>
  </div>
</article>

<style>
  .aud-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--r-xl);
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .aud-card:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-2);
    transform: translateY(-3px);
  }

  .aud-card:focus-within {
    border-color: var(--color-ink);
  }

  .aud-card__media {
    aspect-ratio: 1 / 1;
    background: var(--color-surface-alt);
  }

  .aud-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--obj-pos, 50% 50%);
  }

  .aud-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--sp-3);
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
  }

  .aud-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-5);
  }

  .aud-card__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--color-surface-alt);
    color: var(--brand-red);
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .aud-card:hover .aud-card__icon {
    background: var(--brand-red);
    color: #fff;
  }

  .aud-card__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .aud-card__audience {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-red);
  }

  .aud-card__name {
    font-size: clamp(2.5rem, 1.9rem + 2.4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .aud-card__summary {
    color: var(--color-muted);
    max-width: 28ch;
  }

  .aud-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    margin-top: auto;
    padding-top: var(--sp-4);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .aud-card__link :global(svg) {
    color: var(--brand-red);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .aud-card:hover .aud-card__link :global(svg) {
    transform: translateX(4px);
  }

  /* Área clicável do card inteiro, mantendo um único link acessível */
  .aud-card__stretch {
    position: absolute;
    inset: 0;
  }

  .aud-card__link:focus-visible {
    outline-offset: 2px;
  }

  /* ---------- v2: rodapé colorido por curso (vermelho, vermelho profundo, azul discreto) ---------- */
  .aud-card {
    --tom: var(--brand-red);
    border: 0;
    background: var(--tom);
    color: #fff;
  }

  .aud-card--tom-1 {
    --tom: var(--brand-red-deep);
  }

  .aud-card--tom-2 {
    --tom: var(--brand-navy);
  }

  .aud-card:hover {
    box-shadow: var(--shadow-2);
  }

  .aud-card__icon {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }

  .aud-card:hover .aud-card__icon {
    background: #fff;
    color: var(--tom);
  }

  .aud-card__num,
  .aud-card__summary {
    color: rgb(255 255 255 / 0.82);
  }

  .aud-card__audience {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--fs-sm);
    color: #fff;
    opacity: 0.9;
  }

  .aud-card__name,
  .aud-card__link {
    color: #fff;
  }

  .aud-card__link :global(svg) {
    color: #fff;
  }

  .aud-card__link:focus-visible {
    outline-color: #fff;
  }
</style>
