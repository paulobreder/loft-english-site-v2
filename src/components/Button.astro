---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost-light' | 'light';
  icon?: IconName;
  iconPosition?: 'start' | 'end';
  external?: boolean;
  size?: 'md' | 'lg';
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  icon,
  iconPosition = 'end',
  external = false,
  size = 'md',
  class: className,
  ariaLabel,
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={ariaLabel}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={18} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={18} class="btn__end" />}
  {external && <span class="visually-hidden"> (abre em nova aba)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 48px;
    padding: 0.75rem 1.375rem;
    border-radius: var(--r-pill);
    border: 1.5px solid transparent;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.005em;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .btn--lg {
    min-height: 54px;
    padding: 0.875rem 1.625rem;
    font-size: var(--fs-base);
  }

  .btn :global(.btn__end) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .btn:hover :global(.btn__end) {
    transform: translateX(3px);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn--primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--color-primary-hover);
  }

  .btn--primary:active {
    background: var(--color-primary-active);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-line-strong);
  }

  .btn--secondary:hover {
    border-color: var(--color-ink);
    background: rgb(7 29 61 / 0.04);
  }

  .btn--light {
    background: #fff;
    color: var(--color-ink);
  }

  .btn--light:hover {
    background: var(--brand-ice);
  }

  .btn--ghost-light {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }

  .btn--ghost-light:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.08);
  }

  @media (max-width: 22rem) {
    .btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
