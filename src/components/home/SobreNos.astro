---
/**
 * "Sobre a Loft English" (âncora #sobre-nos; #escola mantido por compatibilidade).
 * Composição editorial inspirada na seção institucional da Overlake, com identidade Loft:
 *   frase de destaque · foto da aula · mapa ilustrado · bisão · avião com trajetória · vídeo da turma
 *   · dois blocos de texto (propósito e compromisso) · chamadas.
 * Grade com áreas nomeadas (sem posicionamento absoluto entre elementos): nada cobre rostos.
 * Textos: proposta institucional a confirmar com a proprietária antes da versão oficial.
 * Vídeo: liberado na prévia; no site oficial só com videoSobreALoft.oficialAutorizado (src/config/site.ts).
 */
import { Picture, Image } from 'astro:assets';
import Mascote from '../Mascote.astro';
import Icon from '../Icon.astro';
import { url } from '../../lib/url';
import { site, isProductionSite, videoSobreALoft } from '../../config/site';
import fotoAula from '../../assets/images/sobre/aula-quadro-ingles-americano.webp';
import mapaCidade from '../../assets/images/mapa-ilustrado-sao-gabriel-da-palha.webp';
import aviao from '../../assets/images/sobre/aviao-trajetoria.png';
import capaVideo from '../../assets/images/sobre/loft-experiencia-alunos-poster.webp';
import fotoReserva from '../../assets/images/escola/aula-coletiva.png';

const mostrarVideo = isProductionSite ? videoSobreALoft.oficialAutorizado : videoSobreALoft.previaAutorizada;
const videoSrc = url('/media/video/loft-experiencia-alunos.mp4');
---

<section class="section section--alt sobre" id="sobre-nos" aria-labelledby="sobre-title">
  <span id="escola" class="sobre__alias" aria-hidden="true"></span>
  <div class="container sobre__grid">
    <!-- 1–2. Identificação e frase -->
    <div class="sobre__cabeca">
      <p class="eyebrow" data-reveal>Sobre a Loft English</p>
      <h2 id="sobre-title" class="sobre__frase" data-reveal style="--reveal-delay:100ms">
        Aqui, o inglês aproxima pessoas e abre caminhos para o mundo.
      </h2>
    </div>

    <!-- 3a. Foto da aula -->
    <div class="sobre__foto media-fill" data-reveal="foto">
      <Picture
        src={fotoAula}
        alt="Aluno de camiseta vermelha acompanha a aula enquanto o professor aponta frases em inglês no quadro, com bandeiras dos Estados Unidos e do Canadá sobre a mesa"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={76}
        widths={[480, 720, 960]}
        sizes="(min-width: 64rem) 34vw, (min-width: 48rem) 52vw, 92vw"
        loading="lazy"
      />
    </div>

    <!-- 3b. Mapa ilustrado (imagem aprovada, sem alterações) -->
    <div class="sobre__mapa media-fill" data-reveal="zoom" style="--reveal-delay:250ms">
      <Picture
        src={mapaCidade}
        alt={`Mapa ilustrado de ${site.city}, com o monumento da cidade, o rio e um marcador da Loft English`}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={80}
        widths={[360, 540, 720]}
        sizes="(min-width: 64rem) 20vw, (min-width: 48rem) 36vw, 46vw"
        loading="lazy"
      />
    </div>

    <!-- 4. Bisão -->
    <div class="sobre__bisao">
      <Mascote variante="corpo" largura={260} reveal="left" revealDelay={450} />
    </div>

    <!-- 5 + 3c. Avião (decorativo) sobre o vídeo da turma -->
    <div class="sobre__lado">
      <div class="sobre__aviao" data-reveal aria-hidden="true">
        <Image src={aviao} alt="" widths={[360, 720]} sizes="(min-width: 64rem) 22rem, 60vw" loading="lazy" />
      </div>

      {
        mostrarVideo ? (
          <div class="video-card" data-reveal="foto" style="--reveal-delay:200ms">
            <button type="button" class="video-card__botao" data-video-abrir aria-label="Reproduzir vídeo da turma da Loft English" aria-haspopup="dialog">
              <Picture
                src={capaVideo}
                alt=""
                formats={['avif', 'webp']}
                quality={80}
                width={480}
                height={640}
                widths={[360, 480]}
                sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 40vw, 72vw"
                loading="lazy"
              />
              <span class="video-card__play" aria-hidden="true">
                <span class="video-card__icone">
                  <Icon name="play" size={22} />
                </span>
                Assistir
              </span>
            </button>
          </div>
        ) : (
          <div class="video-card video-card--foto media-fill" data-reveal="foto" style="--reveal-delay:200ms">
            <Picture
              src={fotoReserva}
              alt="Turma da Loft English em aula, com a professora à frente da sala"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={74}
              widths={[480, 720]}
              sizes="(min-width: 64rem) 24rem, 72vw"
              loading="lazy"
            />
          </div>
        )
      }
    </div>

    <!-- 6–7. Propósito, compromisso e chamadas -->
    <div class="sobre__textos">
      <div class="sobre__bloco" data-reveal>
        <h3>Nosso propósito</h3>
        <p>
          Transformar o aprendizado do inglês em novas possibilidades. Em {site.city}, ajudamos crianças, adolescentes e
          adultos a desenvolverem habilidades para se comunicar, explorar novas culturas e construir seu próprio futuro.
        </p>
      </div>
      <div class="sobre__bloco" data-reveal style="--reveal-delay:120ms">
        <h3>Nosso compromisso</h3>
        <p>
          Promover um ensino de inglês americano que valorize a comunicação, a confiança e as particularidades de cada
          aluno. Porque aprender um novo idioma é muito mais do que aprender palavras:{' '}
          <strong>é descobrir novas formas de viver o mundo.</strong>
        </p>
      </div>
      <div class="sobre__acoes" data-reveal style="--reveal-delay:200ms">
        <a class="sobre__botao" href={url('/equipe/')}>Conheça nossa equipe</a>
        <a class="arrow-link" href={url('/contato/')}>
          Fale com a escola <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div>

  {
    mostrarVideo && (
      <dialog class="video-modal" data-video-modal aria-labelledby="video-modal-title">
        <div class="video-modal__caixa">
          <div class="video-modal__topo">
            <h3 id="video-modal-title" class="video-modal__titulo">Turma da Loft English em atividade</h3>
            <button type="button" class="video-modal__fechar" data-video-fechar>
              <Icon name="x" size={20} />
              <span>Fechar</span>
            </button>
          </div>
          <video class="video-modal__video" controls playsinline preload="none" width="480" height="854" data-src={videoSrc}>
            Seu navegador não reproduz vídeos.
          </video>
        </div>
      </dialog>
    )
  }
</section>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-video-modal]');
  const abrir = document.querySelector<HTMLButtonElement>('[data-video-abrir]');
  if (modal && abrir) {
    const video = modal.querySelector<HTMLVideoElement>('video')!;
    const fechar = modal.querySelector<HTMLButtonElement>('[data-video-fechar]')!;

    abrir.addEventListener('click', () => {
      // O MP4 só é requisitado aqui, depois do clique.
      if (!video.getAttribute('src') && video.dataset.src) video.src = video.dataset.src;
      modal.showModal();
      video.focus();
      video.play().catch(() => {
        /* alguns navegadores pedem um segundo toque: os controles ficam visíveis */
      });
    });

    fechar.addEventListener('click', () => modal.close());
    // Clique no fundo escurecido fecha
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    // Escape dispara "cancel" → "close" nativamente
    modal.addEventListener('close', () => {
      video.pause();
      abrir.focus();
    });
  }
</script>

<style>
  .sobre {
    position: relative;
    overflow-x: clip;
  }

  .sobre__alias {
    position: absolute;
    top: 0;
  }

  /* ---------- Grade (celular: empilhado na ordem de leitura) ---------- */
  .sobre__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'cabeca cabeca'
      'foto   foto'
      'mapa   bisao'
      'textos textos'
      'lado   lado';
    gap: var(--sp-6) var(--sp-4);
  }

  .sobre__cabeca {
    grid-area: cabeca;
    display: grid;
    gap: var(--sp-3);
  }

  .sobre__frase {
    max-width: 22ch;
    font-size: clamp(1.75rem, 1.15rem + 2.3vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--brand-navy);
    text-wrap: balance;
  }

  .sobre__foto {
    grid-area: foto;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .sobre__foto :global(img) {
    object-position: 50% 0%;
  }

  .sobre__mapa {
    grid-area: mapa;
    align-self: start;
    aspect-ratio: 1;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 5px solid #fff;
    box-shadow: var(--shadow-2);
    background: #f6e3c4;
  }

  .sobre__bisao {
    grid-area: bisao;
    align-self: center;
    justify-self: center;
    width: min(100%, 15rem);
  }

  .sobre__bisao :global(.mascote) {
    width: 100%;
  }

  /* Avião + vídeo empilhados (o avião faz o papel das árvores da referência) */
  .sobre__lado {
    grid-area: lado;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
  }

  .sobre__aviao {
    align-self: flex-end;
    width: min(70%, 22rem);
    opacity: 0.9;
  }

  .sobre__aviao :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Trajetória "desenha" da esquerda (marcador) para a direita (avião), uma única vez */
  .reveal-on .sobre__aviao.is-visible {
    animation: trajeto 1.8s var(--reveal-ease) var(--reveal-delay, 300ms) backwards;
  }

  @keyframes trajeto {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ---------- Card do vídeo (capa 3:4) ---------- */
  .video-card {
    position: relative;
    width: min(78%, 24rem);
    aspect-ratio: 3 / 4;
    border-radius: 999px 999px var(--r-xl) var(--r-xl);
    overflow: hidden;
    background: var(--brand-red-deep);
    box-shadow: var(--shadow-2);
  }

  .video-card__botao {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .video-card__botao :global(picture),
  .video-card__botao :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Botão de play no canto inferior esquerdo: não cobre os rostos da capa */
  .video-card__play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.375rem 1rem 0.375rem 0.375rem;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--brand-red-deep);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 800;
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.5);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .video-card__icone {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--brand-red);
    color: #fff;
  }

  .video-card__botao:hover .video-card__play {
    transform: scale(1.05);
  }

  .video-card__botao:focus-visible {
    outline: none;
  }

  .video-card:has(.video-card__botao:focus-visible) {
    outline: 3px solid var(--brand-red);
    outline-offset: 4px;
  }

  .video-card--foto :global(img) {
    object-position: 55% 50%;
  }

  /* ---------- Textos ---------- */
  .sobre__textos {
    grid-area: textos;
    display: grid;
    gap: var(--sp-6);
  }

  .sobre__bloco h3 {
    margin-bottom: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--brand-red);
  }

  .sobre__bloco p {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 42ch;
  }

  .sobre__bloco strong {
    color: var(--brand-navy);
  }

  .sobre__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
  }

  .sobre__botao {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--brand-navy);
    border-radius: var(--r-pill);
    color: var(--brand-navy);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .sobre__botao:hover {
    background: var(--brand-navy);
    color: #fff;
  }

  /* ---------- Tablet ---------- */
  @media (min-width: 48rem) {
    .sobre__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-areas:
        'cabeca cabeca'
        'foto   mapa'
        'foto   bisao'
        'textos lado';
      column-gap: var(--sp-6);
    }

    .sobre__textos {
      align-self: end;
    }

    .video-card {
      width: 100%;
    }

    .sobre__aviao {
      width: 85%;
    }
  }

  /* ---------- Desktop: composição assimétrica da referência ---------- */
  @media (min-width: 64rem) {
    .sobre__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas:
        'cabeca cabeca cabeca cabeca cabeca cabeca cabeca cabeca lado lado lado lado'
        'foto   foto   foto   foto   foto   mapa   mapa   mapa   lado lado lado lado'
        'foto   foto   foto   foto   foto   bisao  bisao  bisao  lado lado lado lado'
        'textos textos textos textos textos textos textos textos lado lado lado lado';
      column-gap: var(--sp-5);
      row-gap: var(--sp-6);
    }

    .sobre__cabeca {
      padding-bottom: var(--sp-4);
    }

    .sobre__lado {
      justify-content: flex-end;
      align-items: stretch;
    }

    .sobre__aviao {
      width: 100%;
    }

    .sobre__textos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-7);
      padding-top: var(--sp-4);
    }

    .sobre__acoes {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Modal do vídeo ---------- */
  .video-modal {
    width: fit-content;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 0;
    border-radius: var(--r-xl);
    background: var(--brand-navy);
    color: #fff;
    overflow: hidden;
  }

  .video-modal::backdrop {
    background: rgb(7 29 61 / 0.82);
  }

  .video-modal__caixa {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
  }

  .video-modal__topo {
    display: flex;
    max-width: min(calc(100vw - 4rem), calc(min(80dvh, 854px) * 480 / 854));
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .video-modal__titulo {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: #fff;
  }

  .video-modal__fechar {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding: 0 1rem;
    border: 1.5px solid rgb(255 255 255 / 0.5);
    border-radius: var(--r-pill);
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .video-modal__fechar:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .video-modal :focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* Proporção real 480 × 854, sem corte: contain e limite pela altura da tela */
  .video-modal__video {
    display: block;
    width: min(calc(100vw - 4rem), calc(min(80dvh, 854px) * 480 / 854));
    height: auto;
    aspect-ratio: 480 / 854;
    object-fit: contain;
    border-radius: var(--r-lg);
    background: #000;
  }
</style>
