---
/**
 * "Sobre nós" — apresentação institucional (âncora #sobre-nos; #escola mantido por compatibilidade).
 * Pilares com fatos confirmados; história, missão e equipe aparecem só quando preenchidos
 * em src/data/institucional/sobre.ts.
 */
import { Picture } from 'astro:assets';
import Mascote from '../Mascote.astro';
import fotoTurma from '../../assets/images/escola/selfie-turma.png';
import mapaCidade from '../../assets/images/mapa-ilustrado-sao-gabriel-da-palha.webp';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { pilares, historia, missao, equipe } from '../../data/institucional/sobre';
import { url } from '../../lib/url';

const temExtras = Boolean(historia || missao || equipe.length);
---

<section class="section section--alt sobre" id="sobre-nos" aria-labelledby="sobre-title">
  <span id="escola" class="sobre__alias" aria-hidden="true"></span>
  <div class="container">
    <div class="sobre__grid">
      <div class="colagem">
        <div class="colagem__foto media-fill" data-reveal="foto">
          <Picture
            src={fotoTurma}
            alt="Professor faz uma selfie sorridente com a turma reunida ao redor da mesa de aula"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={72}
            widths={[480, 720, 960]}
            sizes="(min-width: 64rem) 40vw, 92vw"
            loading="lazy"
          />
        </div>
        <div class="colagem__mapa media-fill" data-reveal="zoom" style="--reveal-delay:350ms">
          <Picture
            src={mapaCidade}
            alt={`Mapa ilustrado de ${site.city}, com o monumento da cidade, o rio e um marcador da Loft English (ilustração, sem escala)`}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            quality={80}
            widths={[360, 540, 720]}
            sizes="(min-width: 64rem) 22vw, 55vw"
            loading="lazy"
          />
        </div>
        <Mascote variante="corpo" largura={260} class="colagem__mascote" reveal="left" revealDelay={650} />
      </div>
      <div class="sobre__content">
        <p class="eyebrow" data-reveal>Sobre nós</p>
        <h2 id="sobre-title" data-reveal style="--reveal-delay:100ms">Conheça a Loft English.</h2>
        <p class="sobre__text" data-reveal style="--reveal-delay:200ms">
          A Loft English é uma escola de inglês em {site.city}, no {site.stateName}, com cursos voltados para crianças,
          adolescentes e adultos. Seu convite é abrir caminhos para usar o idioma na vida — como diz a assinatura da marca,{' '}
          <em lang="en">“{site.slogan}”</em>.
        </p>

        <ul class="pilares">
          {
            pilares.map((p, i) => (
              <li class="pilar" data-reveal="right" style={`--reveal-delay:${150 + i * 120}ms`}>
                <span class="pilar__icon">
                  <Icon name={p.icon} size={22} />
                </span>
                <div>
                  <h3 class="pilar__title" lang={p.titulo === 'Opening the world for you' ? 'en' : undefined}>
                    {p.titulo}
                  </h3>
                  <p class="pilar__text">{p.texto}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="sobre__links" data-reveal>
          <a class="arrow-link" href={url('/equipe/')}>
            Conheça a equipe <Icon name="arrow-right" size={18} />
          </a>
          <a class="arrow-link" href={url('/contato/')}>
            Fale com a escola <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </div>

    {
      temExtras && (
        <div class="sobre__extras">
          {historia && (
            <div class="sobre__bloco">
              <h3>Nossa história</h3>
              <p>{historia}</p>
            </div>
          )}
          {missao && (
            <div class="sobre__bloco">
              <h3>Nosso propósito</h3>
              <p>{missao}</p>
            </div>
          )}
          {equipe.length > 0 && (
            <div class="sobre__equipe">
              <h3>Nossa equipe</h3>
              <ul>
                {equipe.map((m) => (
                  <li>
                    {m.foto && (
                      <div class="sobre__foto media-fill">
                        <Picture
                          src={m.foto}
                          alt={m.alt ?? m.nome}
                          formats={['avif', 'webp']}
                          fallbackFormat="jpg"
                          widths={[240, 480]}
                          sizes="240px"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <strong>{m.nome}</strong>
                    <span>{m.cargo}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .sobre {
    position: relative;
    overflow-x: clip;
  }

  .sobre__alias {
    position: absolute;
    top: 0;
  }

  .sobre__grid {
    display: grid;
    gap: var(--sp-8);
    align-items: center;
  }

  .sobre__content {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .sobre__content h2 {
    font-size: var(--fs-2xl);
    font-weight: 800;
  }

  .sobre__text {
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 36rem;
  }

  .sobre__text em {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--brand-red);
  }

  .pilares {
    list-style: none;
    display: grid;
    width: 100%;
    margin: var(--sp-2) 0;
    border-top: 1px solid var(--color-line-strong);
  }

  .pilar {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .pilar__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-md);
    background: var(--color-surface);
    color: var(--brand-red);
  }

  .pilar__title {
    font-size: var(--fs-md);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .pilar__text {
    margin-top: var(--sp-1);
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .sobre__extras {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--sp-9);
  }

  .sobre__bloco,
  .sobre__equipe {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--color-surface);
  }

  .sobre__extras h3 {
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: var(--sp-3);
  }

  .sobre__bloco p {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 60ch;
  }

  .sobre__equipe ul {
    list-style: none;
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  }

  .sobre__equipe li {
    display: grid;
    gap: var(--sp-1);
  }

  .sobre__foto {
    aspect-ratio: 1;
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-bottom: var(--sp-2);
  }

  .sobre__equipe strong {
    color: var(--color-ink);
  }

  .sobre__equipe span {
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  @media (min-width: 64rem) {
    .sobre__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: clamp(3rem, 1rem + 5vw, 7rem);
    }

    .sobre__extras:has(.sobre__bloco + .sobre__bloco) {
      grid-template-columns: 1fr 1fr;
    }

    .sobre__equipe {
      grid-column: 1 / -1;
    }
  }

  .sobre__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-7);
  }

  /* ---------- v2: colagem com mapa e mascote ---------- */
  .colagem {
    position: relative;
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    padding-bottom: var(--sp-6);
  }

  .colagem__foto {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .colagem__foto :global(img) {
    object-position: 50% 30%;
  }

  .colagem__mapa {
    grid-column: 2;
    margin-top: -26%;
    aspect-ratio: 1;
    border-radius: var(--r-lg);
    overflow: visible;
    border: 6px solid #fff;
    box-shadow: var(--shadow-2);
    background: #f6e3c4;
  }

  .colagem__mapa > :global(picture) {
    border-radius: calc(var(--r-lg) - 6px);
    overflow: hidden;
  }

  @media (min-width: 48rem) {
    .colagem {
      grid-template-columns: 0.85fr 1fr;
    }
  }

  .colagem :global(.colagem__mascote) {
    position: absolute;
    left: -3%;
    bottom: -4%;
    width: min(48%, 15rem);
    z-index: 2;
  }
</style>
