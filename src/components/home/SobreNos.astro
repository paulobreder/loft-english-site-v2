---
/**
 * "Sobre a Loft English" (âncora #sobre-nos; #escola mantido por compatibilidade).
 * Composição editorial inspirada na seção institucional da Overlake, com identidade Loft:
 *   frase de destaque · foto da aula · mapa ilustrado · bisão · avião com trajetória · vídeo da turma
 *   · dois blocos de texto (propósito e compromisso) · chamadas.
 * Grade com áreas nomeadas (sem posicionamento absoluto entre elementos): nada cobre rostos.
 * Textos: proposta institucional a confirmar com a proprietária antes da versão oficial.
 * Vídeo: toca na própria tela em formato de celular, sem som e em loop ("como um GIF"), a pedido do responsável.
 * Liberado na prévia; no site oficial só com videoSobreALoft.oficialAutorizado (src/config/site.ts).
 */
import { Picture } from 'astro:assets';
import Mascote from '../Mascote.astro';
import Icon from '../Icon.astro';
import { url } from '../../lib/url';
import { site, isProductionSite, videoSobreALoft } from '../../config/site';
import fotoAula from '../../assets/images/sobre/aula-quadro-ingles-americano.webp';
import mapaCidade from '../../assets/images/mapa-ilustrado-sao-gabriel-da-palha.webp';
// Capa vertical 480×854 extraída do próprio vídeo (quadro de 2,77 s, o mesmo da capa original).
import capaVideo from '../../assets/images/sobre/loft-experiencia-alunos-capa-vertical.webp';
import fotoReserva from '../../assets/images/escola/aula-coletiva.png';

const mostrarVideo = isProductionSite ? videoSobreALoft.oficialAutorizado : videoSobreALoft.previaAutorizada;
const videoSrc = url('/media/video/loft-experiencia-alunos.mp4');
---

<section class="section section--alt sobre" id="sobre-nos" aria-labelledby="sobre-title">
  <span id="escola" class="sobre__alias" aria-hidden="true"></span>
  <div class="container"><div class="sobre__grid">
    <!-- 1–2. Identificação e frase -->
    <div class="sobre__cabeca">
      <p class="eyebrow" data-reveal>Sobre a Loft English</p>
      <h2 id="sobre-title" class="sobre__frase" data-reveal style="--reveal-delay:100ms">
        Aqui, o inglês aproxima pessoas e abre caminhos para o mundo.
      </h2>
    </div>

    <!-- Palco: mesmas posições e proporções da referência (medidas em % da largura do bloco) -->
    <div class="sobre__palco">
    <!-- 3a. Foto da aula -->
    <div class="sobre__foto media-fill" data-reveal="foto">
      <Picture
        src={fotoAula}
        alt="Aluno de camiseta vermelha acompanha a aula enquanto o professor aponta frases em inglês no quadro, com bandeiras dos Estados Unidos e do Canadá sobre a mesa"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={76}
        widths={[480, 720, 960]}
        sizes="(min-width: 48rem) 22rem, 92vw"
        loading="lazy"
      />
    </div>

    <!-- 3b. Mapa ilustrado (imagem aprovada, sem alterações) -->
    <div class="sobre__mapa media-fill" data-reveal="zoom" style="--reveal-delay:250ms">
      <Picture
        src={mapaCidade}
        alt={`Mapa ilustrado de ${site.city}, com o monumento da cidade, o rio e um marcador da Loft English`}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        quality={80}
        widths={[360, 540, 720]}
        sizes="(min-width: 48rem) 16rem, 46vw"
        loading="lazy"
      />
    </div>

    <!-- 4. Bisão -->
    <div class="sobre__bisao">
      <Mascote variante="corpo" largura={260} reveal="left" revealDelay={450} />
    </div>

    <!-- 5. Avião (no lugar das árvores da referência) -->
      <div class="sobre__aviao" data-reveal aria-hidden="true">
        <!-- "Daqui para o mundo": a rota sai do marcador da Loft no mapa e segue até o avião.
             Coordenadas em décimos de % da largura do bloco (ver CSS do palco). -->
        <svg class="voo" viewBox="0 0 500 270" fill="none" focusable="false">
          <defs>
            <mask id="voo-revela" maskUnits="userSpaceOnUse" x="0" y="0" width="500" height="270">
              <path class="voo__revela" d="M19 252 C 40 110, 260 8, 452 100" stroke="#fff" stroke-width="16" stroke-linecap="round" pathLength="1" />
            </mask>
          </defs>
          <path class="voo__rota" d="M19 252 C 40 110, 260 8, 452 100" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="9 9" mask="url(#voo-revela)" />
          <circle class="voo__pulso" cx="19" cy="252" r="9" stroke="currentColor" stroke-width="3" />
          <circle cx="19" cy="252" r="5" fill="currentColor" />
          <g transform="translate(456 102) rotate(119) translate(-33 -33) scale(2.75)">
            <g class="voo__aviao">
              <path fill="currentColor" d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
            </g>
          </g>
        </svg>
      </div>
      {
        mostrarVideo ? (
          <div class="video-card" data-reveal="foto" style="--reveal-delay:200ms" data-celular>
            <Picture
              src={capaVideo}
              alt=""
              formats={['avif', 'webp']}
              quality={82}
              width={480}
              height={854}
              widths={[320, 480]}
              sizes="(min-width: 48rem) 19rem, 64vw"
              loading="lazy"
              class="video-card__capa"
            />
            <video class="video-card__video" muted loop playsinline preload="none" disablepictureinpicture width="480" height="854" data-src={videoSrc} aria-hidden="true" />
            <button type="button" class="video-card__botao" data-celular-botao aria-pressed="false" aria-label="Reproduzir vídeo da turma da Loft English (sem som)">
              <span class="video-card__play" aria-hidden="true">
                <Icon name="play" size={30} class="video-card__ico-play" />
                <span class="video-card__ico-pausa">
                  <span></span>
                  <span></span>
                </span>
              </span>
            </button>
          </div>
        ) : (
          <div class="video-card video-card--foto media-fill" data-reveal="foto" style="--reveal-delay:200ms">
            <Picture
              src={fotoReserva}
              alt="Turma da Loft English em aula, com a professora à frente da sala"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={74}
              widths={[480, 720]}
              sizes="(min-width: 64rem) 24rem, 72vw"
              loading="lazy"
            />
          </div>
        )
      }
    </div>

    <!-- 6–7. Propósito, compromisso e chamadas -->
    <div class="sobre__textos">
      <div class="sobre__bloco" data-reveal>
        <h3>Nosso propósito</h3>
        <p>
          Transformar o aprendizado do inglês em novas possibilidades. Em {site.city}, ajudamos crianças, adolescentes e
          adultos a desenvolverem habilidades para se comunicar, explorar novas culturas e construir seu próprio futuro.
        </p>
      </div>
      <div class="sobre__bloco" data-reveal style="--reveal-delay:120ms">
        <h3>Nosso compromisso</h3>
        <p>
          Promover um ensino de inglês americano que valorize a comunicação, a confiança e as particularidades de cada
          aluno. Porque aprender um novo idioma é muito mais do que aprender palavras:{' '}
          <strong>é descobrir novas formas de viver o mundo.</strong>
        </p>
      </div>
      <div class="sobre__acoes" data-reveal style="--reveal-delay:200ms">
        <a class="sobre__botao" href={url('/equipe/')}>Conheça nossa equipe</a>
        <a class="arrow-link" href={url('/contato/')}>
          Fale com a escola <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div></div>

</section>

<script>
  /* Vídeo "como GIF": toca na própria tela em formato de celular, sem som e em loop.
     O MP4 só é requisitado no primeiro clique. Clicar de novo pausa. */
  document.querySelectorAll<HTMLElement>('[data-celular]').forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>('video')!;
    const botao = card.querySelector<HTMLButtonElement>('[data-celular-botao]')!;
    video.muted = true;
    const atualizar = (tocando: boolean) => {
      card.classList.toggle('is-tocando', tocando);
      botao.setAttribute('aria-pressed', String(tocando));
      botao.setAttribute('aria-label', tocando ? 'Pausar vídeo da turma da Loft English' : 'Reproduzir vídeo da turma da Loft English (sem som)');
    };
    video.addEventListener('playing', () => atualizar(true));
    video.addEventListener('pause', () => atualizar(false));
    botao.addEventListener('click', () => {
      if (!video.getAttribute('src') && video.dataset.src) video.src = video.dataset.src;
      if (video.paused) video.play().catch(() => atualizar(false));
      else video.pause();
    });
  });
</script>

<style>
  .sobre {
    position: relative;
    overflow-x: clip;
  }

  .sobre__alias {
    position: absolute;
    top: 0;
  }

  /* ---------- Celular: empilhado na ordem de leitura ---------- */
  .sobre__grid {
    display: grid;
    gap: var(--sp-7);
  }

  .sobre__cabeca {
    display: grid;
    gap: var(--sp-3);
  }

  .sobre__frase {
    max-width: 22ch;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--brand-navy);
    text-wrap: balance;
  }

  .sobre__palco {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-4);
  }

  .sobre__foto {
    grid-column: 1 / -1;
    aspect-ratio: 1024 / 1536;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--color-surface-deep);
  }

  .sobre__foto :global(img) {
    object-position: 50% 50%;
  }

  .sobre__mapa {
    grid-row: 2;
    grid-column: 1;
    margin-top: 31%;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 4px solid #fff;
    box-shadow: var(--shadow-2);
    background: #f6e3c4;
  }

  .sobre__bisao {
    grid-row: 2;
    grid-column: 2;
    align-self: end;
    justify-self: center;
    width: min(100%, 13rem);
  }

  .sobre__bisao :global(.mascote) {
    width: 100%;
  }

  /* Celular: a rota fica na mesma linha do mapa e começa no marcador da Loft
     (marcador em 61% × 43% do mapa; mapa = coluna esquerda, ~48% da largura). */
  .sobre__aviao {
    position: relative;
    z-index: 3;
    grid-row: 2;
    grid-column: 1 / -1;
    align-self: start;
    width: 70%;
    margin-left: 26.5%;
    color: var(--brand-red);
    pointer-events: none;
  }

  .voo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* O elemento em si não usa a entrada padrão: quem anima é a rota e o avião */
  :global(.reveal-on) .sobre__aviao.is-visible {
    animation: none;
  }

  :global(.reveal-on) .sobre__aviao:not(.is-visible) {
    opacity: 1;
  }

  .voo__revela {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .voo__aviao {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* 1) a rota se desenha a partir do mapa; 2) o avião aparece no fim; 3) o ponto de partida pulsa devagar */
  :global(.reveal-on) .sobre__aviao:not(.is-visible) .voo__revela {
    stroke-dashoffset: 1;
  }

  :global(.reveal-on) .sobre__aviao:not(.is-visible) .voo__aviao {
    opacity: 0;
  }

  :global(.reveal-on) .sobre__aviao.is-visible .voo__revela {
    animation: voo-rota 1.6s var(--reveal-ease) 0.5s backwards;
  }

  :global(.reveal-on) .sobre__aviao.is-visible .voo__aviao {
    animation: voo-chega 0.7s var(--reveal-ease) 1.85s backwards;
  }

  @keyframes voo-rota {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes voo-chega {
    from {
      opacity: 0;
      transform: translate(-30%, 30%) scale(0.6);
    }
  }

  .voo__pulso {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .voo__pulso {
      animation: voo-pulso 2.8s ease-out infinite;
    }
  }

  @keyframes voo-pulso {
    0% {
      opacity: 0.7;
      transform: scale(0.6);
    }
    80%,
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  /* ---------- Vídeo (proporção real, vertical) ---------- */
  /* Limpo, como as fotos da referência: só cantos arredondados, sem moldura de aparelho */
  .video-card {
    position: relative;
    grid-column: 1 / -1;
    justify-self: center;
    width: min(64%, 18rem);
    aspect-ratio: 480 / 854;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--color-surface-deep);
    isolation: isolate;
  }

  /* Capa e vídeo na proporção real (480 × 854): aparecem inteiros */
  .video-card :global(.video-card__capa),
  .video-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .video-card__video {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .video-card.is-tocando .video-card__video {
    opacity: 1;
  }

  /* Botão cobre a tela inteira; ícone no centro */
  .video-card__botao {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  .video-card__play {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--brand-red);
    color: #fff;
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.85),
      0 12px 28px -8px rgb(0 0 0 / 0.55);
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity 0.25s ease;
  }

  .video-card__play :global(.video-card__ico-play) {
    margin-left: 4px;
  }

  .video-card__ico-pausa {
    display: none;
    gap: 6px;
  }

  .video-card__ico-pausa span {
    width: 6px;
    height: 22px;
    border-radius: 2px;
    background: currentColor;
  }

  .video-card__botao:hover .video-card__play {
    transform: scale(1.06);
  }

  /* Tocando: o ícone some; reaparece (como pausa) ao passar o mouse ou focar pelo teclado */
  .video-card.is-tocando .video-card__play {
    opacity: 0;
  }

  .video-card.is-tocando .video-card__botao:hover .video-card__play,
  .video-card.is-tocando .video-card__botao:focus-visible .video-card__play {
    opacity: 1;
  }

  .video-card.is-tocando :global(.video-card__ico-play) {
    display: none;
  }

  .video-card.is-tocando .video-card__ico-pausa {
    display: flex;
  }

  .video-card__botao:focus-visible {
    outline: none;
  }

  .video-card:has(.video-card__botao:focus-visible) {
    outline: 3px solid var(--brand-red);
    outline-offset: 4px;
  }

  .video-card--foto {
    aspect-ratio: 3 / 4;
    width: min(78%, 24rem);
    border: 0;
    border-radius: 999px 999px var(--r-xl) var(--r-xl);
  }

  .video-card--foto :global(img) {
    object-position: 55% 50%;
  }

  /* ---------- Textos ---------- */
  .sobre__textos {
    display: grid;
    gap: var(--sp-6);
  }

  .sobre__bloco h3 {
    margin-bottom: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--brand-red);
  }

  .sobre__bloco p {
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 42ch;
  }

  .sobre__bloco strong {
    color: var(--brand-navy);
  }

  .sobre__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
  }

  .sobre__botao {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--brand-navy);
    border-radius: var(--r-pill);
    color: var(--brand-navy);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  .sobre__botao:hover {
    background: var(--brand-navy);
    color: #fff;
  }

  /* ---------- A partir do tablet: mesmo arranjo e proporções da referência ----------
     Medidas tiradas do print da Overlake (bloco de 660 px): tudo em % da largura do bloco,
     então a composição escala junto, sem colisões. Altura do palco = 417/660 da largura. */
  @media (min-width: 48rem) {
    .sobre__grid {
      --bloco: min(100%, max(46rem, 62vw), 64rem);
      width: var(--bloco);
      margin-left: max(0px, calc((100% - var(--bloco)) * 0.445));
      gap: 0;
    }

    .sobre__cabeca {
      max-width: 60%;
      margin-bottom: calc(var(--bloco) * 0.047);
    }

    .sobre__frase {
      max-width: none;
      font-size: clamp(1.625rem, 0.6rem + 1.9vw, 2.25rem);
      font-weight: 700;
      line-height: 1.15;
    }

    .sobre__palco {
      display: block;
      position: relative;
      aspect-ratio: 100 / 70;
    }

    .sobre__palco > * {
      position: absolute;
      margin: 0;
      align-self: auto;
    }

    /* Foto 1: canto superior esquerdo, inteira (2:3) */
    .sobre__foto {
      left: 0;
      top: 0;
      width: 34%;
    }

    /* Mapa: ao lado da foto, inteiro (1:1), por cima do canto do vídeo */
    .sobre__mapa {
      left: 36%;
      top: 0;
      width: 26%;
      z-index: 2;
    }

    /* Vídeo: terceira imagem, inteira (480 × 854), mais baixa e com o canto sob o mapa */
    .video-card {
      left: 57%;
      top: 23%;
      width: 30%;
      z-index: 1;
    }

    /* Rota do voo: começa no marcador da Loft no mapa (x 51,9%, y 11,2% da largura do bloco)
       e segue para cima e para a direita, no lugar das árvores da referência.
       Caixa: x 50–100% e y −14% a +13% da largura (topo = −14/70 = −20% da altura do palco). */
    .sobre__aviao {
      left: 50%;
      top: -20%;
      width: 50%;
      z-index: 3;
      pointer-events: none;
    }

    /* Bisão: no lugar da coruja, no canto inferior esquerdo da foto 1 */
    .sobre__bisao {
      left: -4%;
      top: 58%;
      width: 20%;
      z-index: 3;
    }

    .sobre__textos {
      width: 58%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 6%;
      row-gap: var(--sp-6);
      margin-top: var(--sp-2);
    }

    .sobre__bloco p {
      font-size: var(--fs-sm);
      line-height: 1.65;
    }

    .sobre__acoes {
      grid-column: 1 / -1;
      gap: var(--sp-3) var(--sp-5);
    }

    .sobre__acoes a {
      white-space: nowrap;
    }
  }

</style>
