---
/**
 * Depoimentos e reconhecimentos — renderizados SOMENTE com itens reais e autorizados
 * (src/data/institucional/prova-social.ts). Sem itens = nada é exibido.
 */
import Icon from '../Icon.astro';
import { depoimentos, reconhecimentos } from '../../data/institucional/prova-social';

const deps = depoimentos.filter((d) => d.autorizado);
const recs = reconhecimentos.filter((r) => r.autorizado);
---

{
  (deps.length > 0 || recs.length > 0) && (
    <section class="section prova" aria-labelledby="prova-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">{deps.length ? 'Depoimentos' : 'Reconhecimento'}</p>
          <h2 id="prova-title">{deps.length ? 'Quem estuda na Loft English.' : 'Reconhecimento na comunidade.'}</h2>
        </div>

        {deps.length > 0 && (
          <ul class="prova__deps">
            {deps.map((d) => (
              <li class="dep">
                <Icon name="quote" size={28} class="dep__quote" />
                <blockquote>
                  <p>{d.texto}</p>
                </blockquote>
                <p class="dep__autor">
                  <strong>{d.nome}</strong>
                  <span>{d.contexto}</span>
                </p>
                {d.fonte && (
                  <a class="dep__fonte" href={d.fonte} target="_blank" rel="noopener noreferrer">
                    Ver publicação original<span class="visually-hidden"> (abre em nova aba)</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        )}

        {recs.length > 0 && (
          <ul class="prova__recs">
            {recs.map((r) => (
              <li class="rec">
                <span class="rec__icon"><Icon name="award" size={26} /></span>
                <div>
                  <strong>{r.titulo}</strong>
                  <span>{r.emissor} · {r.ano}</span>
                  {r.url && (
                    <a href={r.url} target="_blank" rel="noopener noreferrer">
                      Ver fonte<span class="visually-hidden"> (abre em nova aba)</span>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .prova__deps {
    list-style: none;
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .dep {
    display: grid;
    align-content: start;
    gap: var(--sp-4);
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--r-xl);
  }

  .dep :global(.dep__quote) {
    color: var(--brand-red);
  }

  .dep blockquote {
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-text);
  }

  .dep__autor {
    display: grid;
  }

  .dep__autor strong {
    color: var(--color-ink);
  }

  .dep__autor span,
  .dep__fonte {
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .prova__recs {
    list-style: none;
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .rec {
    display: flex;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-5);
    border-radius: var(--r-lg);
    background: var(--color-surface-alt);
  }

  .rec__icon {
    color: var(--brand-red);
  }

  .rec div {
    display: grid;
  }

  .rec strong {
    color: var(--color-ink);
  }

  .rec span,
  .rec a {
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }
</style>
